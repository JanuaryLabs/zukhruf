# Peer dependencies decide which packages package-lock.json marks dev or
# optional. A user-level legacy-peer-deps=true ignores them, so every local
# npm install would rewrite the flags that the release writes.
legacy-peer-deps=false
# An install fails when a dependency has an install script that allowScripts
# in package.json does not name, so no script is skipped without a review.
strict-allow-scripts=true
