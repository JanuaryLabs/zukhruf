#!/usr/bin/env sh
set -e
export PATH="node_modules/.bin:$PATH"

# nx.json's `sync.applyChanges: true` only auto-applies in an interactive TTY,
# so a commit from a GUI client or an agent shell would carry the trigger
# without the synced tsconfig references. `nx sync` (no --check) has no TTY
# branch — it flushes and exits.
sync_before=$(mktemp)
sync_after=$(mktemp)
git diff --name-only | sort > "$sync_before"
NX_DAEMON=false npx nx sync
git diff --name-only | sort > "$sync_after"

# Stage only what sync itself dirtied. `git add -A` would sweep every
# in-progress edit into the commit; this tree may be shared by concurrent
# agents. A file already modified before the run is left alone. So is a file
# that changed during the run but is not a tsconfig*.json: the only sync
# generator here, @nx/js:typescript-sync, writes only those, so anything else
# is an agent's save. A generator that writes other files would need this
# filter widened, or `nx sync:check` fails CI.
synced=$(comm -13 "$sync_before" "$sync_after" | grep -E '(^|/)tsconfig[^/]*\.json$' || true)
rm -f "$sync_before" "$sync_after"
if [ -n "$synced" ]; then
  echo "Staging synced files:"
  printf '%s\n' "$synced"
  printf '%s\n' "$synced" | tr '\n' '\0' | xargs -0 git add --
fi

# Check the staged blobs, never rewrite files. lint-staged ran
# `prettier --write`, then `git add`ed every file whose unstaged diff changed
# while its tasks ran. In a tree shared by concurrent agents, that included a
# file another agent was saving at that moment, so the commit (and, for
# `git commit --only`, the shared index) took a file it never named. A hook
# that only reads cannot stage anything. It reads each file from the index
# (`git cat-file blob :path`, under the commit's GIT_INDEX_FILE), so a
# partially staged file is checked as it will be committed, and its unstaged
# hunks stay unstaged.
node --input-type=module <<'EOF'
import { execFileSync } from 'node:child_process';
import * as prettier from 'prettier';

const extension = /\.(ts|tsx|mts|cts|js|mjs|cjs|json|md|yml|yaml|css)$/;
const files = execFileSync(
  'git',
  ['diff', '--cached', '--name-only', '-z', '--diff-filter=ACMR'],
  { encoding: 'utf8' },
)
  .split('\0')
  .filter((file) => extension.test(file));
const unformatted = [];
for (const file of files) {
  const info = await prettier.getFileInfo(file, {
    ignorePath: '.prettierignore',
  });
  if (info.ignored || !info.inferredParser) continue;
  const source = execFileSync('git', ['cat-file', 'blob', `:${file}`], {
    encoding: 'utf8',
  });
  const options = await prettier.resolveConfig(file);
  if (!(await prettier.check(source, { ...options, filepath: file }))) {
    unformatted.push(file);
  }
}
if (unformatted.length > 0) {
  console.error('Prettier would reformat these staged files:');
  for (const file of unformatted) console.error(`  ${file}`);
  console.error(
    `Run \`npx prettier --write ${unformatted.join(' ')}\`, stage the result, and commit again.`,
  );
  process.exit(1);
}
EOF
