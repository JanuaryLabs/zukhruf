{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "extends": "@zukhruf/nx/release.json",
  "analytics": false,
  "parallel": 6,
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    "./packages/nx/src/lint/plugin.ts",
    "./packages/nx/src/format/plugin.ts",
    "./packages/nx/src/test/plugin.ts"
  ],
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["lint", "format:check", "..."]
    },
    "test": {
      "dependsOn": ["...", "build"],
      "cache": true,
      "inputs": ["default", "^default", { "runtime": "node --version" }]
    }
  },
  "sync": {
    "applyChanges": true
  },
  "affected": {
    "legacy": true
  }
}
