{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    "./packages/nx/src/lint/plugin.ts",
    "./packages/nx/src/format/plugin.ts",
    {
      "plugin": "./packages/nx/src/test/plugin.ts",
      "options": {
        "flags": ["--test-force-exit"]
      }
    }
  ],
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["lint", "format:check", "..."]
    },
    "test": {
      "dependsOn": ["...", "build"]
    }
  },
  "release": {
    "projects": ["tag:npm:public"],
    "conventionalCommits": {
      "types": {
        "chore": {
          "changelog": {
            "hidden": true
          }
        },
        "refactor": {
          "semverBump": "patch"
        }
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "file": false
      }
    },
    "version": {
      "preVersionCommand": "nx run-many -t build --projects=tag:npm:public",
      "conventionalCommits": true,
      "preserveMatchingDependencyRanges": false,
      "git": {
        "commit": true,
        "tag": true,
        "push": true
      }
    },
    "releaseTag": {
      "pattern": "release/{version}"
    }
  },
  "sync": {
    "applyChanges": true
  }
}
