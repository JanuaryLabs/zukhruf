    "image: postgres:18-alpine docker.io/library/postgres@sha256:aea692538b8982646f587a0dc0263986ac063c043ab28a43076a07d099a0ef53",
    "client: @zukhruf/docker from packages/docker (node --conditions=@zukhruf/source); one node process per slot",
