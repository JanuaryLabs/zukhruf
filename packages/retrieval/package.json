{
  "name": "@zukhruf/retrieval",
  "version": "0.8.70",
  "description": "The query side of RAG: retrievers that search a passage table by meaning or keywords in SQLite, Postgres or SQL Server, fuse lists, rerank and post-process, and give the best passages first with a score that is higher for a better passage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/retrieval"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/retrieval#readme",
  "keywords": [
    "retrieval",
    "rag",
    "retriever",
    "vector-search",
    "bm25",
    "reciprocal-rank-fusion",
    "rerank",
    "ai-sdk",
    "sqlite",
    "postgres",
    "sql-server"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "@zukhruf/source": "./src/sqlite.ts",
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    },
    "./postgres": {
      "@zukhruf/source": "./src/postgres.ts",
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    },
    "./sqlserver": {
      "@zukhruf/source": "./src/sqlserver.ts",
      "types": "./dist/sqlserver.d.ts",
      "import": "./dist/sqlserver.js",
      "default": "./dist/sqlserver.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.70",
    "@zukhruf/statistics": "^0.8.70",
    "@zukhruf/vectors": "^0.8.70",
    "ai": "^7.0.179",
    "pgvector": "^0.3.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "@zukhruf/parameterized-test": "^0.8.70",
    "@zukhruf/sqlite-open": "^0.8.70",
    "@zukhruf/testing": "^0.8.70",
    "mssql": "^12.8.0",
    "pg": "^8.23.1"
  }
}
