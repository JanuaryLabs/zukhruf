{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/spec",
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
