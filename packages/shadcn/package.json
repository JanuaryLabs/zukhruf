{
  "name": "@zukhruf/shadcn",
  "version": "0.3.57",
  "description": "Every shadcn/ui component for Base UI with the nova preset, as one package: import the components from one entry and the styles from one stylesheet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/shadcn"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/shadcn#readme",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "base-ui",
    "react",
    "components",
    "tailwindcss",
    "ui"
  ],
  "type": "module",
  "imports": {
    "#components/*": {
      "@zukhruf/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "#lib/*": {
      "@zukhruf/source": "./src/lib/*.tsx",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "#hooks/*": {
      "@zukhruf/source": "./src/hooks/*.ts",
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "theme.css",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.57.0",
    "react-day-picker": "^10.0.2",
    "react-is": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.5",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
