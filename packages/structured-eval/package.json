{
  "name": "@zukhruf/structured-eval",
  "version": "0.1.0",
  "private": true,
  "description": "A runner-agnostic core for structured-output evals: one walk compares a stated value with its case, each scorer gives a ratio for one record, and a ratio of sums adds the ratios of many records. Each array has its alignment (by position, or by best match), and SOB's evaluate.py is a configuration of the same scorers. An adapter gives the scores to promptfoo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/structured-eval"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/structured-eval#readme",
  "keywords": [
    "evaluation",
    "structured-output",
    "extraction",
    "precision",
    "recall",
    "promptfoo"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./promptfoo": {
      "@zukhruf/source": "./src/promptfoo/index.ts",
      "types": "./dist/promptfoo/index.d.ts",
      "import": "./dist/promptfoo/index.js",
      "default": "./dist/promptfoo/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@cfworker/json-schema": "4.1.4",
    "@zukhruf/python": "*",
    "@zukhruf/statistics": "*",
    "munkres": "^2.1.1"
  },
  "devDependencies": {
    "@zukhruf/testing": "*",
    "promptfoo": "0.125.1",
    "python-random": "1.0.0"
  }
}
