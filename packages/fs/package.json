{
  "name": "@zukhruf/fs",
  "version": "0.8.2",
  "description": "File writes a reader never sees half done, a file lock the kernel frees when its holder dies, and a file stamp that tells that a file changed, as git does. Retries Windows' short refusals. Names a file after any key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/fs"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/fs#readme",
  "keywords": [
    "fs",
    "atomic",
    "write",
    "durable",
    "fsync",
    "rename",
    "exclusive",
    "lock",
    "file-lock",
    "flock",
    "sqlite",
    "windows",
    "eperm",
    "stat",
    "file-stamp",
    "change-detection"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.2",
    "@zukhruf/sqlite-open": "^0.8.2"
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.8.2"
  }
}
