{
  "name": "@zukhruf/testing",
  "version": "0.5.2",
  "description": "Disposable fixtures for integration tests: Docker containers, database servers, SQLite and DuckDB databases, HTTP servers, streams, temporary directories and intercepted requests. Node's global setup and teardown remove what a killed test run left behind.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/testing#readme",
  "keywords": [
    "testing",
    "integration-tests",
    "fixtures",
    "docker",
    "postgres",
    "mysql",
    "mariadb",
    "sql-server",
    "disposable"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./node": {
      "@zukhruf/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./async": {
      "@zukhruf/source": "./src/async/index.ts",
      "types": "./dist/async/index.d.ts",
      "import": "./dist/async/index.js",
      "default": "./dist/async/index.js"
    },
    "./docker": {
      "@zukhruf/source": "./src/docker/index.ts",
      "types": "./dist/docker/index.d.ts",
      "import": "./dist/docker/index.js",
      "default": "./dist/docker/index.js"
    },
    "./postgres": {
      "@zukhruf/source": "./src/databases/postgres.ts",
      "types": "./dist/databases/postgres.d.ts",
      "import": "./dist/databases/postgres.js",
      "default": "./dist/databases/postgres.js"
    },
    "./mysql": {
      "@zukhruf/source": "./src/databases/mysql.ts",
      "types": "./dist/databases/mysql.d.ts",
      "import": "./dist/databases/mysql.js",
      "default": "./dist/databases/mysql.js"
    },
    "./mariadb": {
      "@zukhruf/source": "./src/databases/mariadb.ts",
      "types": "./dist/databases/mariadb.d.ts",
      "import": "./dist/databases/mariadb.js",
      "default": "./dist/databases/mariadb.js"
    },
    "./sqlserver": {
      "@zukhruf/source": "./src/databases/sqlserver.ts",
      "types": "./dist/databases/sqlserver.d.ts",
      "import": "./dist/databases/sqlserver.js",
      "default": "./dist/databases/sqlserver.js"
    },
    "./clickhouse": {
      "@zukhruf/source": "./src/databases/clickhouse.ts",
      "types": "./dist/databases/clickhouse.d.ts",
      "import": "./dist/databases/clickhouse.js",
      "default": "./dist/databases/clickhouse.js"
    },
    "./sqlite": {
      "@zukhruf/source": "./src/databases/sqlite.ts",
      "types": "./dist/databases/sqlite.d.ts",
      "import": "./dist/databases/sqlite.js",
      "default": "./dist/databases/sqlite.js"
    },
    "./duckdb": {
      "@zukhruf/source": "./src/databases/duckdb.ts",
      "types": "./dist/databases/duckdb.d.ts",
      "import": "./dist/databases/duckdb.js",
      "default": "./dist/databases/duckdb.js"
    },
    "./bigquery": {
      "@zukhruf/source": "./src/databases/bigquery.ts",
      "types": "./dist/databases/bigquery.d.ts",
      "import": "./dist/databases/bigquery.js",
      "default": "./dist/databases/bigquery.js"
    },
    "./http": {
      "@zukhruf/source": "./src/http/http-server.ts",
      "types": "./dist/http/http-server.d.ts",
      "import": "./dist/http/http-server.js",
      "default": "./dist/http/http-server.js"
    },
    "./streams": {
      "@zukhruf/source": "./src/streams/stream-harness.ts",
      "types": "./dist/streams/stream-harness.d.ts",
      "import": "./dist/streams/stream-harness.js",
      "default": "./dist/streams/stream-harness.js"
    },
    "./fs": {
      "@zukhruf/source": "./src/fs/temporary-files.ts",
      "types": "./dist/fs/temporary-files.d.ts",
      "import": "./dist/fs/temporary-files.js",
      "default": "./dist/fs/temporary-files.js"
    },
    "./msw": {
      "@zukhruf/source": "./src/msw/msw.ts",
