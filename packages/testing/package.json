      "import": "./dist/msw/msw.js",
      "default": "./dist/msw/msw.js"
    },
    "./docker-global-setup": {
      "@zukhruf/source": "./src/scripts/docker-global-setup.ts",
      "types": "./dist/scripts/docker-global-setup.d.ts",
      "import": "./dist/scripts/docker-global-setup.js",
      "default": "./dist/scripts/docker-global-setup.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "@google-cloud/bigquery": "^8.3.1",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "mariadb": "^3.5.4",
    "mssql": "^12.7.4",
    "msw": "^3.0.3",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1"
  },
  "dependencies": {
    "@zukhruf/docker": "^0.5.2",
    "nano-spawn": "^2.1.0",
    "p-memoize": "^8.0.0",
    "p-retry": "^8.0.1"
  },
  "peerDependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "@google-cloud/bigquery": "^8.3.1",
    "mssql": "^12.7.0",
    "msw": "^3.0.3"
  },
  "peerDependenciesMeta": {
    "@duckdb/node-api": {
      "optional": true
    },
    "@google-cloud/bigquery": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  }
}
