{
  "name": "@zukhruf/coprocess",
  "version": "0.3.45",
  "description": "A coprocess: a long-lived child process that the parent talks to over stdin and stdout, with JSON values on lines, and stops with SIGTERM and then SIGKILL after a grace period.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/coprocess"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/coprocess#readme",
  "keywords": [
    "coprocess",
    "child-process",
    "subprocess",
    "json-lines",
    "ndjson",
    "jsonl",
    "stdio",
    "worker",
    "sigterm"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.3.45",
    "execa": "10.2.1"
  }
}
