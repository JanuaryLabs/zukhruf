  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/vector-decisions#readme",
  "keywords": [
    "embeddings",
    "decisions",
    "classification",
    "abstention",
    "venn"
  ],
  "type": "module",
  "exports": {
