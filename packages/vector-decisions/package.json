    "@zukhruf/testing": "*"
  },
  "dependencies": {
    "@huggingface/hub": "^2.17.11",
    "@stdlib/blas-ext-base-ssumpw": "^0.3.1",
    "@zukhruf/async": "*",
    "@zukhruf/embedding-cache": "*",
