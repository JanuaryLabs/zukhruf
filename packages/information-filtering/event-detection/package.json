{
  "name": "@zukhruf/event-detection",
  "version": "0.4.0",
  "description": "Puts reports of one real event into one event. It shortlists the nearest reports by embedding similarity, scores each pair with a frozen logistic model, and clusters the 7-day window again with group average on each new publish day.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/information-filtering/event-detection"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/information-filtering/event-detection#readme",
  "keywords": [
    "event-detection",
    "event-coreference",
    "news-clustering",
    "deduplication",
    "hierarchical-clustering",
    "sqlite",
    "node-sqlite"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/sqlite-drift": "^0.4.0",
    "@zukhruf/sqlite-transaction": "^0.4.0",
    "ml-hclust": "^4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.79",
    "@mozilla/readability": "0.6.0",
    "@zukhruf/embeddings": "^0.4.0",
    "ai": "^7.0.154",
    "linkedom": "0.18.14",
    "ml-matrix": "6.15.1",
    "munkres": "2.1.1"
  }
}
