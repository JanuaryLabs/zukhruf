{
  "name": "@zukhruf/rpc",
  "version": "0.8.70",
  "description": "Calls between threads and processes over a worker, a port or an IPC channel: a supervised connection, calls that reject at once when the peer goes or go again, and errors that keep their class and fields. After Go's net/rpc and .NET's StreamJsonRpc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/rpc"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/rpc#readme",
  "keywords": [
    "rpc",
    "ipc",
    "worker-threads",
    "message-port",
    "child-process",
    "connection",
    "reconnect",
    "error-serialization"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.70"
  },
  "devDependencies": {
    "@zukhruf/parameterized-test": "^0.8.70",
    "@zukhruf/process": "^0.8.70",
    "@zukhruf/testing": "^0.8.70"
  }
}
