{
  "name": "@zukhruf/pipes",
  "version": "0.8.38",
  "description": "One name gives a pipe that one program listens on and other programs of the computer connect to: a Unix socket in a folder of this user on macOS and Linux, a named pipe on Windows. After .NET's `System.IO.Pipes`, on `node:net`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/pipes"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/pipes#readme",
  "keywords": [
    "pipe",
    "named-pipe",
    "unix-socket",
    "unix-domain-socket",
    "ipc",
    "net",
    "windows"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@zukhruf/fs": "^0.8.38",
    "@zukhruf/testing": "^0.8.38"
  }
}
