{
  "name": "@zukhruf/nx",
  "version": "0.8.59",
  "description": "The Nx part of the monorepo standard: inference plugins for format, test, lint, opentofu and prisma targets, and generators for the root files (preset, init), apps (node-app, react-app, pair, ui-package), a db package (prisma) and delivery (dokploy).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/nx"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/nx#readme",
  "keywords": [
    "nx",
    "nx-plugin",
    "inference",
    "createNodes",
    "monorepo",
    "prettier",
    "format",
    "check",
    "node-test",
    "test",
    "eslint",
    "lint",
    "opentofu",
    "terraform",
    "prisma",
    "generator",
    "preset",
    "dokploy"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./release.json": "./release.json",
    "./format": {
      "@zukhruf/source": "./src/format/plugin.ts",
      "types": "./dist/format/plugin.d.ts",
      "import": "./dist/format/plugin.js",
      "default": "./dist/format/plugin.js"
    },
    "./test": {
      "@zukhruf/source": "./src/test/plugin.ts",
      "types": "./dist/test/plugin.d.ts",
      "import": "./dist/test/plugin.js",
      "default": "./dist/test/plugin.js"
    },
    "./lint": {
      "@zukhruf/source": "./src/lint/plugin.ts",
      "types": "./dist/lint/plugin.d.ts",
      "import": "./dist/lint/plugin.js",
      "default": "./dist/lint/plugin.js"
    },
    "./opentofu": {
      "@zukhruf/source": "./src/opentofu/plugin.ts",
      "types": "./dist/opentofu/plugin.d.ts",
      "import": "./dist/opentofu/plugin.js",
      "default": "./dist/opentofu/plugin.js"
    },
    "./prisma": {
      "@zukhruf/source": "./src/prisma/plugin.ts",
      "types": "./dist/prisma/plugin.d.ts",
      "import": "./dist/prisma/plugin.js",
      "default": "./dist/prisma/plugin.js"
    }
  },
  "generators": "./generators.json",
  "nx-migrations": {
    "migrations": "./migrations.json",
    "packageGroup": [
      "@zukhruf/async",
      "@zukhruf/authentication",
      "@zukhruf/coprocess",
      "@zukhruf/diagram",
      "@zukhruf/docker",
      "@zukhruf/election",
      "@zukhruf/embedding-cache",
      "@zukhruf/embeddings",
      "@zukhruf/eslint",
      "@zukhruf/evals",
      "@zukhruf/event-detection",
      "@zukhruf/fencing",
      "@zukhruf/fs",
      "@zukhruf/git-hooks",
      "@zukhruf/launchd",
      "@zukhruf/lease",
      "@zukhruf/mutex",
      "@zukhruf/pipes",
      "@zukhruf/pool",
      "@zukhruf/python",
      "@zukhruf/relevance-filtering",
      "@zukhruf/shadcn",
      "@zukhruf/shutdown",
      "@zukhruf/single-flight",
      "@zukhruf/snapshot-differential",
      "@zukhruf/sqlite-changefeed",
      "@zukhruf/sqlite-data-version",
      "@zukhruf/sqlite-drift",
      "@zukhruf/sqlite-federation",
      "@zukhruf/sqlite-notify",
      "@zukhruf/sqlite-open",
      "@zukhruf/sqlite-queue",
      "@zukhruf/sqlite-snapshot",
      "@zukhruf/sqlite-transaction",
      "@zukhruf/ssh",
      "@zukhruf/statistics",
      "@zukhruf/testing",
      "@zukhruf/ui",
      "@zukhruf/vectors"
    ]
  },
  "files": [
    "dist",
    "generators.json",
    "migrations.json",
    "release.json",
    "src/generators/*/schema.json",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nx/devkit": ">=24.0.6 <25.0.0",
    "@nx/node": ">=24.0.6 <25.0.0",
    "@nx/react": ">=24.0.6 <25.0.0",
    "@nx/vite": ">=24.0.6 <25.0.0",
    "@nx/vitest": ">=24.0.6 <25.0.0",
    "@zukhruf/testing": "^0.8.59",
    "nx": ">=24.0.6 <25.0.0",
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@nx/node": {
      "optional": true
    },
    "@nx/react": {
      "optional": true
    },
    "@nx/vite": {
      "optional": true
    },
    "@nx/vitest": {
      "optional": true
    },
    "@zukhruf/testing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zukhruf/eslint": "^0.8.59",
    "@zukhruf/fs": "^0.8.59",
    "@zukhruf/testing": "^0.8.59",
    "semver": "^7.8.5"
  }
}
