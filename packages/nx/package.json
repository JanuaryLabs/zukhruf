{
  "name": "@zukhruf/nx",
  "version": "0.8.34",
  "description": "The Nx part of the monorepo standard: inference plugins for format, test, lint, opentofu and prisma targets, and generators for the root files (preset, init), apps (node-app, react-app, pair, ui-package), a db package (prisma) and delivery (dokploy).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/nx"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/nx#readme",
  "keywords": [
    "nx",
    "nx-plugin",
    "inference",
    "createNodes",
    "monorepo",
    "prettier",
    "format",
    "check",
    "node-test",
    "test",
    "eslint",
    "lint",
    "opentofu",
    "terraform",
    "prisma",
    "generator",
    "preset",
    "dokploy"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./format": {
      "@zukhruf/source": "./src/format/plugin.ts",
      "types": "./dist/format/plugin.d.ts",
      "import": "./dist/format/plugin.js",
      "default": "./dist/format/plugin.js"
    },
    "./test": {
      "@zukhruf/source": "./src/test/plugin.ts",
      "types": "./dist/test/plugin.d.ts",
      "import": "./dist/test/plugin.js",
      "default": "./dist/test/plugin.js"
    },
    "./lint": {
      "@zukhruf/source": "./src/lint/plugin.ts",
      "types": "./dist/lint/plugin.d.ts",
      "import": "./dist/lint/plugin.js",
      "default": "./dist/lint/plugin.js"
    },
    "./opentofu": {
      "@zukhruf/source": "./src/opentofu/plugin.ts",
      "types": "./dist/opentofu/plugin.d.ts",
      "import": "./dist/opentofu/plugin.js",
      "default": "./dist/opentofu/plugin.js"
    },
    "./prisma": {
      "@zukhruf/source": "./src/prisma/plugin.ts",
      "types": "./dist/prisma/plugin.d.ts",
      "import": "./dist/prisma/plugin.js",
      "default": "./dist/prisma/plugin.js"
    }
  },
  "generators": "./generators.json",
  "files": [
    "dist",
    "generators.json",
    "src/generators/*/schema.json",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nx/devkit": ">=23.2.1 <25.0.0",
    "@nx/node": ">=23.2.1 <25.0.0",
    "@nx/react": ">=23.2.1 <25.0.0",
    "@nx/vite": ">=23.2.1 <25.0.0",
    "@nx/vitest": ">=23.2.1 <25.0.0",
    "nx": ">=23.2.1 <25.0.0",
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@nx/node": {
      "optional": true
    },
    "@nx/react": {
      "optional": true
    },
    "@nx/vite": {
      "optional": true
    },
    "@nx/vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zukhruf/fs": "^0.8.34",
    "@zukhruf/testing": "^0.8.34"
  }
}
