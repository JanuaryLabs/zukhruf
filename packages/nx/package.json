{
  "name": "@zukhruf/nx",
  "version": "0.5.1",
  "description": "The Nx part of the monorepo standard, one area per subpath: format gives each project format and a cached format:check with Prettier, test gives node --test targets, and lint adds the packages of @zukhruf/eslint to the inputs of lint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/nx"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/nx#readme",
  "keywords": [
    "nx",
    "nx-plugin",
    "inference",
    "createNodes",
    "monorepo",
    "prettier",
    "format",
    "check",
    "node-test",
    "test",
    "eslint",
    "lint"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./format": {
      "@zukhruf/source": "./src/format/plugin.ts",
      "types": "./dist/format/plugin.d.ts",
      "import": "./dist/format/plugin.js",
      "default": "./dist/format/plugin.js"
    },
    "./test": {
      "@zukhruf/source": "./src/test/plugin.ts",
      "types": "./dist/test/plugin.d.ts",
      "import": "./dist/test/plugin.js",
      "default": "./dist/test/plugin.js"
    },
    "./lint": {
      "@zukhruf/source": "./src/lint/plugin.ts",
      "types": "./dist/lint/plugin.d.ts",
      "import": "./dist/lint/plugin.js",
      "default": "./dist/lint/plugin.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nx/devkit": ">=23.2.1 <25.0.0",
    "nx": ">=23.2.1 <25.0.0",
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.5.1"
  }
}
