{
  "name": "nx",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nx/src",
  "projectType": "library",
  "tags": ["layer:island", "std:tool"],
  "targets": {
    "e2e:smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node src/e2e/smoke.ts"
      }
    },
    "e2e:upgrade": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node src/e2e/upgrade.ts"
      }
    }
  }
}
