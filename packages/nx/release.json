{
  "release": {
    "projects": ["tag:npm:public"],
    "conventionalCommits": {
      "types": {
        "refactor": {
          "semverBump": "patch"
        }
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "file": false
      }
    },
    "version": {
      "preVersionCommand": "nx run-many -t build --projects=tag:npm:public",
      "conventionalCommits": true,
      "preserveMatchingDependencyRanges": false,
      "git": {
        "commit": false,
        "tag": false,
        "push": false
      }
    },
    "releaseTag": {
      "pattern": "release/{version}"
    }
  }
}
