{
  "name": "@zukhruf/git-hooks",
  "version": "0.8.11",
  "description": "Git hooks in TypeScript, a class per step. Pre-commit checks staged files with Prettier, stages only what nx sync wrote, and builds generated files. Commit-msg stops a subject whose scope nx release misreads. Pre-push builds pushed commits in snapshots.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/git-hooks"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/git-hooks#readme",
  "keywords": [
    "git",
    "hooks",
    "pre-commit",
    "pre-push",
    "commit-msg",
    "build",
    "snapshot",
    "prettier",
    "staged",
    "index",
    "nx",
    "sync",
    "codegen"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.11",
    "@zukhruf/fs": "^0.8.11"
  },
  "peerDependencies": {
    "eslint": "^9.30.0 || ^10.0.0",
    "nx": ">=21.0.0",
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "nx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.8.11",
    "eslint": "^10.12.0",
    "jsonc-eslint-parser": "^3.3.0",
    "prettier": "^3.9.9"
  }
}
