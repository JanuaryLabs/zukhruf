{
  "name": "@zukhruf/git-hooks",
  "version": "0.6.0",
  "description": "Git hooks in TypeScript. Pre-commit checks staged files with Prettier, runs nx sync and stages only what it wrote, and builds affected generated files. Pre-push builds each pushed commit in a snapshot, not the working tree. A repo adds a step as a class.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/git-hooks"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/git-hooks#readme",
  "keywords": [
    "git",
    "hooks",
    "pre-commit",
    "pre-push",
    "build",
    "snapshot",
    "prettier",
    "staged",
    "index",
    "nx",
    "sync",
    "codegen"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/fs": "^0.6.0"
  },
  "peerDependencies": {
    "nx": ">=21.0.0",
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "nx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.6.0",
    "prettier": "^3.9.9"
  }
}
