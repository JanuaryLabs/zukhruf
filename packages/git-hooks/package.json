{
  "name": "@zukhruf/git-hooks",
  "version": "0.3.42",
  "description": "Git hooks written in TypeScript. A pre-commit hook runs steps in order against the staged commit: it checks the staged copy of each file with Prettier and changes nothing, runs nx sync and stages only the files that sync wrote, and builds generated files when nx says their projects are affected. A repo adds a step of its own as a class.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/git-hooks"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/git-hooks#readme",
  "keywords": [
    "git",
    "hooks",
    "pre-commit",
    "prettier",
    "staged",
    "index",
    "nx",
    "sync",
    "codegen"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/fs": "^0.3.42"
  },
  "peerDependencies": {
    "nx": ">=21.0.0",
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "nx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.3.42",
    "prettier": "^3.9.9"
  }
}
