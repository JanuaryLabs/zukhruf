{
  "name": "@zukhruf/sqlite-snapshot",
  "version": "0.6.4",
  "description": "A read-only snapshot of a SQLite database that another process owns and writes. One read transaction, so the tables agree; the newest rows in the WAL show. Checks the columns a reader needs. Throws its own UnavailableError and MissingColumnsError.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/sqlite/snapshot"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/sqlite/snapshot#readme",
  "keywords": [
    "sqlite",
    "node-sqlite",
    "snapshot",
    "read-transaction",
    "wal",
    "read-only"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/sqlite-reader": "^0.6.4"
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.6.4"
  }
}
