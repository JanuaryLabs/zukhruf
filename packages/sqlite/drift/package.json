{
  "name": "@zukhruf/sqlite-drift",
  "version": "0.6.4",
  "description": "Declarative schema management for SQLite. A declaration lists the CREATE statements of the tables, indexes, views and triggers one caller owns. Gives the drift from what SQLite stores (missing, fits or stale) and applies the declaration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/sqlite/drift"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/sqlite/drift#readme",
  "keywords": [
    "sqlite",
    "node-sqlite",
    "schema",
    "schema-drift",
    "declarative-schema",
    "migration",
    "sqlite-schema",
    "ddl"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/sqlite-transaction": "^0.6.4"
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.6.4"
  }
}
