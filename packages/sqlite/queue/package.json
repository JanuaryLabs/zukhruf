{
  "name": "@zukhruf/sqlite-queue",
  "version": "0.4.1",
  "description": "pg-boss's job queue API on node:sqlite: a declared subset of 13 PgBoss methods (queues, send, work, findJobs, cancel, fail, schedules). A parity suite requires the same result from real pg-boss and from SQLite, so a caller can change engines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/sqlite/queue"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/sqlite/queue#readme",
  "keywords": [
    "sqlite",
    "node-sqlite",
    "pg-boss",
    "job-queue",
    "background-jobs",
    "cron",
    "scheduler"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.4.1",
    "@zukhruf/sqlite-drift": "^0.4.1",
    "@zukhruf/sqlite-transaction": "^0.4.1",
    "cron-parser": "^5.10.1",
    "pg-boss": "12.35.1",
    "rrule-temporal": "^2.2.7",
    "serialize-error": "^13.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@zukhruf/testing": "^0.4.1"
  }
}
