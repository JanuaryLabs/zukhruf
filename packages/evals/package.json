{
  "name": "@zukhruf/evals",
  "version": "0.8.12",
  "description": "Scores the answers of an eval against their labels, with one import path for each shape of answer: a core of ratios and totals, ./structured for structured values, ./classification for labels as scikit-learn scores them, and ./promptfoo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/evals"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/evals#readme",
  "keywords": [
    "evaluation",
    "evals",
    "scorers",
    "structured-output",
    "extraction",
    "classification",
    "scikit-learn",
    "precision",
    "recall",
    "promptfoo"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./classification": {
      "@zukhruf/source": "./src/classification/index.ts",
      "types": "./dist/classification/index.d.ts",
      "import": "./dist/classification/index.js",
      "default": "./dist/classification/index.js"
    },
    "./promptfoo": {
      "@zukhruf/source": "./src/promptfoo/index.ts",
      "types": "./dist/promptfoo/index.d.ts",
      "import": "./dist/promptfoo/index.js",
      "default": "./dist/promptfoo/index.js"
    },
    "./structured": {
      "@zukhruf/source": "./src/structured/index.ts",
      "types": "./dist/structured/index.d.ts",
      "import": "./dist/structured/index.js",
      "default": "./dist/structured/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/python": "^0.8.12",
    "@zukhruf/statistics": "^0.8.12"
  },
  "peerDependencies": {
    "@cfworker/json-schema": "4.1.4",
    "munkres": "^2.1.1"
  },
  "peerDependenciesMeta": {
    "@cfworker/json-schema": {
      "optional": true
    },
    "munkres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.4",
    "@zukhruf/random": "*",
    "@zukhruf/testing": "^0.8.12",
    "munkres": "^2.1.1",
    "promptfoo": "0.125.1",
    "python-random": "1.0.0"
  }
}
