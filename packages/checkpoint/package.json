{
  "name": "@zukhruf/checkpoint",
  "version": "0.8.70",
  "description": "Keep how far a reader of a stream got: a checkpoint for each consumer group, stream and partition, with an opaque versioned position and map states that commit all or nothing, fenced against older claims, in memory, SQLite, Postgres or SQL Server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/checkpoint"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/checkpoint#readme",
  "keywords": [
    "checkpoint",
    "stream",
    "offset",
    "consumer-group",
    "partition",
    "resume",
    "fencing",
    "state",
    "sqlite",
    "postgres"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "@zukhruf/source": "./src/sqlite.ts",
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    },
    "./postgres": {
      "@zukhruf/source": "./src/postgres.ts",
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "default": "./dist/postgres.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/fencing": "^0.8.70",
    "@zukhruf/sqlite-drift": "^0.8.70",
    "@zukhruf/sqlite-transaction": "^0.8.70"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@zukhruf/parameterized-test": "^0.8.70",
    "@zukhruf/sqlite-open": "^0.8.70",
    "@zukhruf/testing": "^0.8.70",
    "pg": "^8.23.1"
  }
}
