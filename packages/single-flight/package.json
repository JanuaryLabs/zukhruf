{
  "name": "@zukhruf/single-flight",
  "version": "0.3.36",
  "description": "Callers of one key share the run already in flight, in one process or across the processes that use one directory, and get its outcome instead of a busy error.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/single-flight"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/single-flight#readme",
  "keywords": [
    "single-flight",
    "singleflight",
    "request-coalescing",
    "deduplication",
    "mutex",
    "inter-process"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.3.36",
    "@zukhruf/election": "^0.3.36",
    "@zukhruf/fencing": "^0.3.36",
    "@zukhruf/fs": "^0.3.36",
    "@zukhruf/lease": "^0.3.36"
  },
  "devDependencies": {
    "@zukhruf/mutex": "^0.3.36"
  }
}
