{
  "name": "@zukhruf/ui",
  "version": "0.3.40",
  "description": "React components built from the components of @zukhruf/shadcn, such as TheButton: a button with a delayed loading spinner, an icon and a tooltip.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/ui#readme",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "button",
    "react",
    "components",
    "tailwindcss",
    "ui"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0"
  },
  "peerDependencies": {
    "@zukhruf/shadcn": "^0.3.40",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
