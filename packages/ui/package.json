{
  "name": "@zukhruf/ui",
  "version": "0.8.70",
  "description": "React components for apps that use `@zukhruf/shadcn`: `TheButton`, a button that shows a loading spinner after a delay, an icon and a tooltip, and `Editable`, a saved text value edited in place. `@zukhruf/shadcn` is a peer dependency.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/ui#readme",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "button",
    "editable",
    "inline-edit",
    "react",
    "components",
    "tailwindcss",
    "ui"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.5.0"
  },
  "peerDependencies": {
    "@zukhruf/shadcn": "^0.8.70",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
