{
  "name": "@zukhruf/mutex",
  "version": "0.3.47",
  "description": "A mutex with interchangeable lock stores, from one object to every process on a host, with fencing tokens on every lease.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/mutex"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/mutex#readme",
  "keywords": [
    "mutex",
    "lock",
    "fencing-token",
    "inter-process"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./remote": null,
    "./session": null,
    "./*": {
      "@zukhruf/source": "./src/lock-stores/*/index.ts",
      "types": "./dist/lock-stores/*/index.d.ts",
      "import": "./dist/lock-stores/*/index.js",
      "default": "./dist/lock-stores/*/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.3.47",
    "@zukhruf/election": "^0.3.47",
    "@zukhruf/fencing": "^0.3.47",
    "@zukhruf/fs": "^0.3.47",
    "@zukhruf/lease": "^0.3.47"
  },
  "peerDependencies": {
    "@zukhruf/docker": "^0.3.47"
  },
  "peerDependenciesMeta": {
    "@zukhruf/docker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@zukhruf/docker": "^0.3.47",
    "@zukhruf/testing": "^0.3.47",
    "hono": "^4.13.13",
    "mariadb": "^3.5.4",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "tedious": "^20.3.3"
  }
}
