{
  "name": "@zukhruf/mutex",
  "version": "0.3.35",
  "description": "A mutex with interchangeable lock stores, from one object to every process on a host, with fencing tokens on every lease.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/mutex"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/mutex#readme",
  "keywords": [
    "mutex",
    "lock",
    "fencing-token",
    "inter-process"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.3.35",
    "@zukhruf/election": "^0.3.35",
    "@zukhruf/fencing": "^0.3.35",
    "@zukhruf/fs": "^0.3.35",
    "@zukhruf/lease": "^0.3.35"
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.3.35",
    "hono": "^4.13.13"
  }
}
