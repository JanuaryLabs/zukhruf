{
  "name": "@zukhruf/statistics",
  "version": "0.8.12",
  "description": "The percentile bootstrap, NumPy's quantile methods, and numpy.sum, numpy.mean and numpy.nanmean in JavaScript, to the last bit: resamples with a random generator that the caller gives, the percentile interval of their statistic, and NumPy's pairwise sum.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/statistics"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/statistics#readme",
  "keywords": [
    "statistics",
    "bootstrap",
    "confidence-interval",
    "quantile",
    "numpy"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stdlib/blas-ext-base-gsumpw": "^0.3.1"
  }
}
