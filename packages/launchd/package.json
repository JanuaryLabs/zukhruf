{
  "name": "@zukhruf/launchd",
  "version": "0.8.18",
  "description": "Install the jobs of launchd, the service manager of macOS, from a job typed with the key names of launchd.plist(5), and drive their services with the current subcommands of launchctl. After Homebrew services and nix-darwin, on /bin/launchctl.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/launchd"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/launchd#readme",
  "keywords": [
    "launchd",
    "launchctl",
    "launch-agent",
    "launch-daemon",
    "plist",
    "service",
    "daemon",
    "macos"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.18",
    "@zukhruf/fs": "^0.8.18",
    "plist": "^5.1.1"
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.8.18"
  }
}
