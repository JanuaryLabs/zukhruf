{
  "name": "@zukhruf/json-lines-process",
  "version": "0.3.41",
  "description": "A long-lived child process that takes and gives JSON values, one per line, and stops with SIGTERM and then SIGKILL after a grace period.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/json-lines-process"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/json-lines-process#readme",
  "keywords": [
    "child-process",
    "subprocess",
    "json-lines",
    "ndjson",
    "jsonl",
    "stdio",
    "worker",
    "sigterm"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.3.40",
    "execa": "10.2.1"
  }
}
