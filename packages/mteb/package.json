{
  "name": "@zukhruf/mteb",
  "version": "0.4.0",
  "description": "A TypeScript port of the evaluation engine of MTEB (Massive Text Embedding Benchmark) 2.26.28, with the same scores and files as MTEB. Its tasks and evaluators cover retrieval, reranking, pair classification, STS, clustering, classification, multilabel classification and regression. It has trec_eval and scikit-learn metrics, BM25 in the languages of MTEB, hybrid search, cross-encoders, results, comparison tables, a paired bootstrap test, the result and embedding caches and the CO₂ tracker. The encoder is an AI SDK embedding model.",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/mteb"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/mteb#readme",
  "keywords": [
    "mteb",
    "embeddings",
    "benchmark",
    "evaluation",
    "retrieval",
    "ndcg",
    "trec-eval",
    "bm25",
    "bm25s",
    "ai-sdk"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./report": {
      "@zukhruf/source": "./src/report/index.ts",
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js",
      "default": "./dist/report/index.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "NOTICE",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@stdlib/blas-ext-base-gsumpw": "^0.3.1",
    "@stdlib/blas-ext-base-ssumpw": "^0.3.1",
    "@zukhruf/async": "*",
    "@zukhruf/evals": "*",
    "@zukhruf/process": "*",
    "@zukhruf/python": "*",
    "@zukhruf/random": "*",
    "@zukhruf/retrieval": "*",
    "@zukhruf/statistics": "*",
    "ai": "^7.0.179",
    "cephes": "^3.3.4",
    "heap": "^0.2.7",
    "hyparquet": "^1.33.1",
    "ml-matrix": "^6.15.1",
    "python-random": "1.0.0",
    "rapidfuzz-js": "^0.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.94",
    "@ai-sdk/provider": "^4.0.39",
    "@types/heap": "^0.2.35",
    "@zukhruf/fs": "*",
    "@zukhruf/parameterized-test": "*",
    "@zukhruf/testing": "*"
  }
}
