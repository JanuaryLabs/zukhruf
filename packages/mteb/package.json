{
  "name": "@zukhruf/mteb",
  "version": "0.4.0",
  "description": "A TypeScript port of the MTEB evaluation engine (Massive Text Embedding Benchmark, version 2.26.28): tasks, evaluators, metrics, search, results and the result cache, for retrieval, reranking, pair classification, STS, clustering, classification, multilabel classification and regression. The encoder is an AI SDK embedding model.",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/mteb"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/mteb#readme",
  "keywords": [
    "mteb",
    "embeddings",
    "benchmark",
    "evaluation",
    "retrieval",
    "ndcg",
    "trec-eval",
    "bm25",
    "bm25s",
    "ai-sdk"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./report": {
      "@zukhruf/source": "./src/report/index.ts",
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js",
      "default": "./dist/report/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@stdlib/blas-ext-base-gsumpw": "^0.3.1",
    "@stdlib/blas-ext-base-ssumpw": "^0.3.1",
    "ai": "^7.0.154",
    "hyparquet": "^1.32.0",
    "jsonc-parser": "^3.3.1",
    "ml-matrix": "^6.15.1",
    "rapidfuzz-js": "^0.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.79",
    "@ai-sdk/provider": "^4.0.34",
    "@zukhruf/testing": "*"
  }
}
