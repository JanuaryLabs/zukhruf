{
  "name": "mteb",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mteb/src",
  "projectType": "library",
  "tags": ["layer:island", "std:domain"],
  "targets": {
    "codecarbon-data": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/src/dependencies/codecarbon/data/**"],
      "outputs": ["{projectRoot}/dist/dependencies/codecarbon/data"],
      "options": {
        "command": "node -e \"require('node:fs').cpSync('src/dependencies/codecarbon/data', 'dist/dependencies/codecarbon/data', { recursive: true })\"",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "dependsOn": ["^build", "codecarbon-data"]
    },
    "compare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node examples/compare-models.ts",
        "cwd": "{projectRoot}"
      }
    },
    "table": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node examples/table.ts",
        "cwd": "{projectRoot}"
      }
    },
    "report": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node examples/report.ts",
        "cwd": "{projectRoot}"
      }
    },
    "chart": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "uv run examples/chart.py",
        "cwd": "{projectRoot}"
      }
    }
  }
}
