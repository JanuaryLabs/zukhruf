{
  "name": "@zukhruf/pool",
  "version": "0.8.20",
  "description": "Lends long-lived workers, such as native helper processes, to one job at a time: startups decide when workers start, sizings decide how many run, evictions decide when an idle worker closes, and a worker that exits is replaced.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/pool"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/pool#readme",
  "keywords": [
    "pool",
    "worker-pool",
    "resource-pool",
    "concurrency",
    "hill-climbing",
    "capacity",
    "child-process"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.20",
    "@zukhruf/election": "^0.8.20",
    "@zukhruf/sqlite-notify": "^0.8.20",
    "@zukhruf/sqlite-open": "^0.8.20",
    "@zukhruf/sqlite-queue": "^0.8.20",
    "p-queue": "10.0.0"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.4.0",
    "@zukhruf/fs": "^0.8.20",
    "@zukhruf/testing": "^0.8.20"
  }
}
