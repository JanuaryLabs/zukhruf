{
  "name": "@zukhruf/pool",
  "version": "0.8.63",
  "description": "One pool of long-lived workers, such as native helpers, for each computer: every program sends its jobs to one store, and an elected owner runs them, while startups, sizings and evictions decide when workers start, how many run and when they close.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/pool"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/pool#readme",
  "keywords": [
    "pool",
    "worker-pool",
    "resource-pool",
    "concurrency",
    "hill-climbing",
    "capacity",
    "child-process"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.63",
    "@zukhruf/election": "^0.8.63",
    "@zukhruf/pipes": "^0.8.63",
    "@zukhruf/sqlite-notify": "^0.8.63",
    "@zukhruf/sqlite-open": "^0.8.63",
    "@zukhruf/sqlite-queue": "^0.8.63"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.5.0",
    "@zukhruf/fs": "^0.8.63",
    "@zukhruf/testing": "^0.8.63",
    "p-queue": "10.0.0"
  }
}
