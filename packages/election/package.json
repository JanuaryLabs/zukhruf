{
  "name": "@zukhruf/election",
  "version": "0.8.19",
  "description": "Elects a leader whose term ends when it resigns or dies, with a higher epoch each term; backends subclass one campaign. SqliteElection, on one host: the leader pushes heartbeats on a pipe; candidates and observers wait on it and end a frozen leader.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/election"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/election#readme",
  "keywords": [
    "leader-election",
    "election",
    "leader",
    "epoch",
    "inter-process",
    "sqlite"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.19",
    "@zukhruf/fs": "^0.8.19",
    "@zukhruf/lease": "^0.8.19",
    "@zukhruf/pipes": "^0.8.19"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.4.0",
    "@zukhruf/testing": "^0.8.19"
  }
}
