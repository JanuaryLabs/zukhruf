  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@vgpu/wgsl": "^0.6.0",
    "cn": "^0.4.0",
    "vgpu": "^0.6.0"
  },
  "peerDependencies": {
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
