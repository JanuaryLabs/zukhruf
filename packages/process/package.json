{
  "name": "@zukhruf/process",
  "version": "0.8.70",
  "description": "Start a process and know how it ends: a run gives its exit code or signal and its output with no throw; a started process is ready at a line or a message, stops its group with SIGTERM, SIGCONT and then SIGKILL, and ends with its parent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JanuaryLabs/zukhruf",
    "directory": "packages/process"
  },
  "bugs": {
    "url": "https://github.com/JanuaryLabs/zukhruf/issues"
  },
  "homepage": "https://github.com/JanuaryLabs/zukhruf/tree/main/packages/process#readme",
  "keywords": [
    "process",
    "child-process",
    "subprocess",
    "spawn",
    "exec",
    "coprocess",
    "process-group",
    "sigterm",
    "ipc"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@zukhruf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.70",
    "execa": "10.2.1"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.5.0",
    "@zukhruf/fs": "^0.8.70",
    "@zukhruf/parameterized-test": "^0.8.70"
  }
}
