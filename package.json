    "@happy-dom/global-registrator": "20.14.5",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/fontkit": "2.0.9",
