{
  "name": "zukhruf",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/JanuaryLabs/zukhruf",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .husky && git config blame.ignoreRevsFile .git-blame-ignore-revs || exit 0",
    "verify:packages": "nx run-many -t build --projects=tag:scope:public && node tools/verify-packages.ts"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-plugin-es-x": "10.0.1",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "jsonc-eslint-parser": "3.3.0",
    "lint-staged": "17.6.0",
    "nx": "23.2.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
