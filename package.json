{
  "name": "zukhruf",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/JanuaryLabs/zukhruf",
  "workspaces": [
    "packages/*",
    "packages/sqlite/*",
    "packages/information-filtering/*",
    "packages/macos/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .husky && git config blame.ignoreRevsFile .git-blame-ignore-revs || exit 0"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@e18e/eslint-plugin": "0.8.1",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@nx/devkit": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/react": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@rolldown/plugin-babel": "0.3.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-es-x": "10.1.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.3.1",
    "eslint-plugin-unicorn": "80.0.0",
    "fontkit": "3.0.0",
    "happy-dom": "21.0.4",
    "jscpd": "5.4.3",
    "jsonc-eslint-parser": "3.3.0",
    "motion": "14.14.0",
    "nx": "24.0.6",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sqlite-vec": "0.1.9",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "yaml-eslint-parser": "2.1.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "webgpu": true,
    "@vgpu/adapter-node": true,
    "nx": false,
    "unrs-resolver": false,
    "fsevents": false,
    "ssh2": false,
    "cpu-features": false,
    "@parcel/watcher": false
  },
  "overrides": {
    "@nx/react": {
      "express": "5.3.0"
    },
    "@sdk-it/hono": {
      "typescript": "$typescript"
    }
  }
}
