{
  "name": "zukhruf",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/JanuaryLabs/zukhruf",
  "workspaces": [
    "packages/*",
    "packages/sqlite/*",
    "apps/*"
